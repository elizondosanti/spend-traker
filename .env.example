# Copy this file to .env.local and fill in what you need.
# With nothing configured the app still runs locally: embedded database, no AI, no Gmail.

# Postgres connection string (Neon). Empty = local embedded PGlite in .data/
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Optional separate key for encrypting the Gmail refresh token (base64, 32 bytes).
# If empty, a key is derived from SESSION_SECRET.
ENCRYPTION_KEY=

# Public URL of the app (detected automatically on Vercel)
APP_URL=http://localhost:3000

# Google OAuth (Gmail read-only). Redirect URI: {APP_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API (Text Search, new) to recognize unfamiliar merchants. Optional.
GOOGLE_PLACES_API_KEY=

# Vercel AI Gateway. On Vercel, VERCEL_OIDC_TOKEN is injected automatically.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# USD per million tokens, used only to display the estimated AI cost per movement
AI_PRICE_IN=0.3
AI_PRICE_OUT=2.5

# Set to "true" on a public demo deployment: only the seeded demo account can be used,
# sign-up and login are disabled.
DEMO_ONLY=

# Protects /api/cron/gmail (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
