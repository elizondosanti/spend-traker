# Copiá este archivo a .env.local y completá lo que tengas.
# Sin nada configurado la app igual corre en local (base embebida, sin IA, sin Gmail).

# Base de datos Postgres (Neon). Vacío = PGlite local en .data/pglite
DATABASE_URL=

# Obligatorio en producción. Generalo con: openssl rand -base64 32
SESSION_SECRET=
# Opcional: clave aparte para cifrar el token de Gmail (si no, se deriva de SESSION_SECRET)
ENCRYPTION_KEY=

# URL pública de la app (en Vercel se detecta sola)
APP_URL=http://localhost:3000

# Google OAuth (Gmail solo lectura). Redirect URI: {APP_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places (Text Search New) para reconocer comercios nuevos
GOOGLE_PLACES_API_KEY=

# Vercel AI Gateway (en Vercel alcanza con VERCEL_OIDC_TOKEN, que se inyecta solo)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# Precio en USD por millón de tokens, para mostrar el costo de IA
AI_PRICE_IN=0.3
AI_PRICE_OUT=2.5

# Protege /api/cron/gmail (Vercel lo manda como Bearer automáticamente)
CRON_SECRET=
